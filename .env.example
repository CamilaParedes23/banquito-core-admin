# ============================================================
# Banco BanQuito V2 - core-admin-service
# Local/Docker/Cloud variables. Do not commit real secrets.
# ============================================================

SPRING_PROFILES_ACTIVE=default
SPRING_APPLICATION_NAME=core-admin-service
SERVER_PORT=8083
APP_TIME_ZONE=America/Guayaquil

# Local execution from Maven
ADMIN_DB_URL=jdbc:mysql://localhost:33062/banquito_core_admin_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Guayaquil
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=BanQuitoRoot2026!

# Docker/cloud example:
# ADMIN_DB_URL=jdbc:mysql://mysql-admin:3306/banquito_core_admin_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Guayaquil

JWT_ISSUER=banquito-identity-access
JWT_SECRET=BanQuitoIdentityJwtSecretKeyForDevelopmentOnlyChangeMe2026

DEMO_DATA_ENABLED=true
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1
HIBERNATE_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=false
MANAGEMENT_HEALTH_DETAILS=always


